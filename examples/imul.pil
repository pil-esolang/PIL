# A fun little implementation of integer multiplication.
# Written before sign and step-towards functions were
# added and ported to the newest PIL version.
move-to-zero(n)
   let cond, tmp;
   gr n, 0, cond;
   jmp cond, move-to-zero-positive;
   le n, 0, cond;
   jmp cond, move-to-zero-negative;
   return 0;
move-to-zero-positive:
   sub n, 1, tmp;
   return tmp;
move-to-zero-negative:
   add n, 1, tmp;
   return tmp;

# Multiply two integers. While not effective, it works.
# Also supports negative numbers.
imul(a, b)
   let result, c, sa, cond;
   set 0, result;
   set b, c;
   set a, sa;
   greq b, 0, cond;
   jmp cond, imul-loop;
   neg sa, sa;
imul-loop:
   eq c, 0, cond;
   jmp cond, imul-end;
   add sa, result, result;
   move-to-zero c;
   set r$0, c;
   goto imul-loop;
imul-end:
   return result;

# Test here. Negative numbers have to be wrapped in []
# so for formatting reasons we do the same for
# non-negative numbers.
main()
   imul [ 9], [ 8];
   println R$0;
   imul [-2], [ 4];
   println R$0;
   imul [-4], [-5];
   println R$0;
   imul [ 4], [-2];
   println R$0;
