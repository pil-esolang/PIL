# Simple input-output application. Feel free to
# add more things to read from the user.
main()
   local name, age-string, age;
   print "Input your name: ";
   readln name;
   goto main-input-age;

main-input-age-error:
   print "Invalid input, try again. ";

main-input-age:
   print "Input your age: ";
   readln age-string;
   to-int age-string, age;
   string-free age-string;
   is-null age, $0;
   jmp $0, main-input-age-error;
   incr age;

   printfln "Hello, {}! You will be {} next year!", name, age;
   string-free name;
