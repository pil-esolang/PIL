@include "tiles.pil"

; create a new level from file and return it
create-level(path)
   let file, level, map, width, height, line, cond, tmp, tmp2, i, n, coins, plrpos, enemies
   file-open path, 'r', file
   jmp file, create-level-file-exists

   printfln "File '{}' does not exist.", path
   string-free path
   exit 0
create-level-file-exists:
   array-new map
   array-new enemies
   set 0, height
   set 0, coins

create-level-start:
   file-readln file, line
   is-null line, cond
   jmp cond, create-level-end   

   incr height
   is-null width, cond
   jmpn cond, create-level-width-non-null
   string-size line, width
create-level-width-non-null:
   string-size line, tmp
   eq width, tmp, cond
   jmp cond, create-level-width-matches

   printfln "File '{}' is malformed: lines have varying width.", path
   array-deep-free enemies, map
   string-free line, path
   file-close file
   exit 0
create-level-width-matches:
   set 0, i
   string-size line, n
create-level-string-start:
   greq i, n, cond
   jmp cond, create-level-string-end

   string-at line, i, tmp
   valtable tmp, tmp, 'p', player-t, 'e', empty-t, 'b', block-t, 'c', coin-t, 'm', mine-t, 'v', vbat-t, 'h', hbat-t, unknown-t
   array-size map, tmp2
   create-enemy tmp2, tmp, enemies
   array-push map, tmp
   eq tmp, coin-t, cond
   add coins, cond, coins
   eq tmp, player-t, cond
   jmpn cond, create-level-skip-player
   is-null plrpos, cond
   jmp cond, create-level-plrpos-null
   
   printfln "File '{}' contains multiple players.", path
   array-deep-free enemies, map
   string-free line, path
   file-close file
   exit 0
create-level-plrpos-null:
   set tmp2, plrpos

create-level-skip-player:
   incr i
   goto create-level-string-start
create-level-string-end:
   string-free line
   goto create-level-start
create-level-end:
   file-close file

   is-null plrpos, cond
   jmpn cond, create-level-plrpos-checked

   printfln "File '{}' doesn't contain a player.", path
   array-deep-free enemies, map
   string-free path
   exit 0
create-level-plrpos-checked:
   leeq coins, 0, cond
   jmpn cond, create-level-coins-checked

   printfln "File '{}' doesn't contain any coins.", path
   array-deep-free enemies, map
   string-free path
   exit 0
create-level-coins-checked:
   make Level level, width, height, map, plrpos, 0, coins, 0, enemies
   return level

; prints the level to the console
print-level(level)
   let i, n, cond, tmp
   set 0, i
   mul level.width, level.height, n

   printfln "Coins collected: {}/{}", level.coins, level.collected
print-level-start:
   greq i, n, cond
   jmp cond, print-level-end

   array-at level.map, i, tmp
   valtable tmp, tmp, empty-t, "__", player-t, "\e[34mPL\e[0m", block-t, "\e[30mBB\e[0m", coin-t, "_\e[33mO\e[0m", dead-t, "_\e[31mX\e[0m", mine-t, "\e[31mXX\e[0m", vbat-t, "\e[31m||\e[0m", hbat-t, "\e[31m==\e[0m", "??"
   print tmp

   incr i
   mod i, level.width, cond
   jmp cond, print-level-skip-newline
   printch '\n'
print-level-skip-newline:

   goto print-level-start
print-level-end:

; clear level
clear-level(level)
   let i, cond, n
   add level.height, 1, n ; off by one on purpose, see the loop
   set 0, i
clear-level-start:
   greq i, n, cond
   jmp cond, clear-level-end
   print "\r\e[K\e[F"
   incr i
   goto clear-level-start
clear-level-end:
   print "\r\e[K"
   flush

; move player
move-player(level, x, y)
   let row, col, n, target, ty, tx cond, cond2, tmp

   ; handle y axis
   set level.plrpos, target
   mul level.width, level.height, n
   div level.plrpos, level.width, row
   add row, y, ty
   le ty, 0, cond
   jmp cond, move-player-no-op
   greq ty, level.height, cond
   jmp cond, move-player-no-op
   mul y, level.width, tmp
   add target, tmp, target

   ; handle x axis
   mod level.plrpos, level.width, col
   add col, x, tx
   le tx, 0, cond
   jmp cond, move-player-no-op
   greq tx, level.width, cond
   jmp cond, move-player-no-op
   add target, x, target

   ; move the player
   array-at level.map, target, tmp
   leeq tmp, coin-t, cond
   jmp cond, move-player-skip-death
   set 1, level.dead
   array-set level.map, level.plrpos, dead-t
   goto move-player-no-op

move-player-skip-death:
   neq tmp, empty-t, cond
   neq tmp, coin-t, cond2
   and cond, cond2, cond
   jmp cond, move-player-no-op
   jmp cond2, move-player-skip-coin
   incr level.coins

move-player-skip-coin:
   array-set level.map, level.plrpos, empty-t
   array-set level.map, target, player-t
   set target, level.plrpos

move-player-no-op:
   return

; play a level
play-level(level)
   let ch, cond
play-level-start:
   move-enemies level
   print-level level
   print "Move > "
   flush
   jmp level.dead, play-level-lost
   readch ch
   jmptable ch, 'a', play-level-left, 's', play-level-down, 'd', play-level-right, 'w', play-level-up, 'q', play-level-exit, play-level-input-end
play-level-left:
   move-player level [-1], [ 0]
   goto play-level-input-end
play-level-down:
   move-player level [ 0], [ 1]
   goto play-level-input-end
play-level-right:
   move-player level [ 1], [ 0]
   goto play-level-input-end
play-level-up:
   move-player level [ 0], [-1]
   goto play-level-input-end
play-level-exit:
   deep-free level
   printch '\n'
   exit 0
play-level-input-end:
   greq level.coins, level.collected, cond
   jmp cond, play-level-won
   jmp level.dead, play-level-lost

   clear-level level
   goto play-level-start

play-level-won:
   clear-level level
   print-level level
   println "Level won!"
   return

play-level-lost:
   clear-level level
   print-level level
   println "\e[31m\nLevel lost!\e[0m"
   return
