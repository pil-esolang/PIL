@include "tiles.pil"
@include "read.pil"

# prints the level to the console
print-level(level)
   let i, n, cond, tmp;
   set 0, i;
   mul level.width, level.height, n;

   printfln "Coins collected: {}/{}", level.coins, level.collected;
print-level-start:
   greq i, n, cond;
   jmp cond, print-level-end;

   array-at level.map, i, tmp;
   valtable tmp, tmp,
      Tile.empty,    " .",
      Tile.player,   "\e[34mPL\e[0m",
      Tile.block,    "\e[90m██\e[0m",
      Tile.coin,     "\e[33m O\e[0m",
      Tile.dead,     "\e[31m X\e[0m",
      Tile.mine,     "\e[31mXX\e[0m",
      Tile.vbat,     "\e[31m||\e[0m",
      Tile.hbat,     "\e[31m==\e[0m",
      Tile.glimmer,  "\e[31m<>\e[0m",
      Tile.seeker,   "\e[31m[]\e[0m",
      Tile.observer, "\e[31m/\\\e[0m",
      Tile.wanderer, "\e[31m{}\e[0m",
                     "??";

   print tmp;
   incr i;
   mod i, level.width, cond;
   jmp cond, print-level-skip-newline;
   printch '\n';
print-level-skip-newline:

   goto print-level-start;
print-level-end:

# clear level
clear-level(level)
   let i, cond, n;
   add level.height, 1, n; # off by one on purpose, see the loop
   set 0, i;
clear-level-start:
   greq i, n, cond;
   jmp cond, clear-level-end;
   print "\r\e[K\e[F";
   incr i;
   goto clear-level-start;
clear-level-end:
   print "\r\e[K";
   flush;

# move player
move-player(level, dx, dy)
   let target, ty, tx, x, y, cond, cond2, tmp;
   call x, y, get-x-y, level, level.plrpos;
   set level.plrpos, target;

   # handle y axis
   add y, dy, ty;
   le ty, 0, cond;
   jmp cond, move-player-no-op;
   greq ty, level.height, cond;
   jmp cond, move-player-no-op;
   mul dy, level.width, tmp;
   add target, tmp, target;

   # handle x axis
   add x, dx, tx;
   le tx, 0, cond;
   jmp cond, move-player-no-op;
   greq tx, level.width, cond;
   jmp cond, move-player-no-op;
   add target, dx, target;

   # move the player
   array-at level.map, target, tmp;
   leeq tmp, Tile.coin, cond;
   jmp cond, move-player-skip-death;
   set 1, level.dead;
   array-set level.map, level.plrpos, Tile.dead;
   goto move-player-no-op;

move-player-skip-death:
   neq tmp, Tile.empty, cond;
   neq tmp, Tile.coin, cond2;
   and cond, cond2, cond;
   jmp cond, move-player-no-op;
   jmp cond2, move-player-skip-coin;
   incr level.coins;

move-player-skip-coin:
   array-set level.map, level.plrpos, Tile.empty;
   array-set level.map, target, Tile.player;
   set target, level.plrpos;

move-player-no-op:
   return;

# play a level
play-level(level)
   let ch, cond;
play-level-start:
   move-enemies level;
   print-level level;
   print "Move > ";
   flush;
   jmp level.dead, play-level-lost;

   readch ch;
   jmptable ch,
      'a',  play-level-left,
      's',  play-level-down,
      'd',  play-level-right,
      'w',  play-level-up,
      'q',  play-level-exit,
            play-level-input-end;

play-level-left:
   move-player level, [-1], [ 0];
   goto play-level-input-end;
play-level-down:
   move-player level, [ 0], [ 1];
   goto play-level-input-end;
play-level-right:
   move-player level, [ 1], [ 0];
   goto play-level-input-end;
play-level-up:
   move-player level, [ 0], [-1];
   goto play-level-input-end;
play-level-exit:
   deep-free level;
   printch '\n';
   exit 0;
play-level-input-end:
   greq level.coins, level.collected, cond;
   jmp cond, play-level-won;
   jmp level.dead, play-level-lost;

   clear-level level;
   goto play-level-start;

play-level-won:
   clear-level level;
   print-level level;
   println "Level won!";
   return;

play-level-lost:
   clear-level level;
   print-level level;
   println "\e[31m\nLevel lost!\e[0m";
   return;
