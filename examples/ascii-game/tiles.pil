struct Enemy (
   pos,  # int
   type, # Tile
   tile, # Tile
   dirx, # int
   diry, # int
   turn, # int
)

struct Level (
   width,      # int
   height,     # int
   map,        # array<Tile>
   plrpos,     # int
   coins,      # int
   collected,  # int
   dead,       # bool
   enemies,    # array<Enemy>
)

# map tiles. everything after coin kills you and everything after mine is an enemy
enum Tile (
   unknown = [-1],
   empty,
   player,
   block,
   coin,
   dead,
   mine,
   vbat,
   hbat,
   glimmer,
   seeker,
   observer,
   wanderer,
)

# utility functions
get-random-dir(enemy)
   randi-range [-1], [ 1], enemy.dirx;
   randi-range [-1], [ 1], enemy.diry;

get-x-y(level, pos)
   let x, y;
   div pos, level.width, y;
   mod pos, level.width, x;
   return x, y;

get-dir(start, end)
   let cond;
   le start, end, cond;
   jmp cond, get-dir-le;
   gr start, end, cond;
   jmp cond, get-dir-gr;
get-dir-eq: return [ 0];
get-dir-le: return [ 1];
get-dir-gr: return [-1];

int-distance(sx, sy, dx, dy)
   let rx1, rx2, ry1, ry2, x, y, distance;
   sub sx, dx, rx1;
   sub dx, sx, rx2;
   sub sy, dy, ry1;
   sub dy, sy, ry2;
   max rx1, rx2, x;
   max ry1, ry2, y;
   add x, y, distance;
   return distance;

# create a new enemy
create-enemy(pos, type, enemies)
   let enemy, cond;
   gr type, Tile.mine, cond;
   jmp cond, create-enemy-start;
   return;
create-enemy-start:
   make Enemy, enemy, pos, type, Tile.empty, 0, 0, 0;
   jmptable type,
      Tile.vbat,     create-enemy-vbat,
      Tile.hbat,     create-enemy-hbat,
      Tile.glimmer,  create-enemy-glimmer,
                     create-enemy-end;

create-enemy-vbat:
   set 1, enemy.diry;
   goto create-enemy-end;
create-enemy-hbat:
   set 1, enemy.dirx;
   goto create-enemy-end;
create-enemy-glimmer:
   set 1, enemy.diry;
   goto create-enemy-end;
create-enemy-end:
   array-push enemies, enemy;

# move a single enemy
move-enemy(level, enemy, dx, dy)
   let target, x, y, ty, tx, cond, cond2, tmp;
   call x, y, get-x-y, level, enemy.pos;
   set enemy.pos, target;

   # handle y axis
   add y, dy, ty;
   le ty, 0, cond;
   jmp cond, move-enemy-no-op;
   greq ty, level.height, cond;
   jmp cond, move-enemy-no-op;
   mul dy, level.width, tmp;
   add target, tmp, target;

   # handle x axis
   add x, dx, tx;
   le tx, 0, cond;
   jmp cond, move-enemy-no-op;
   greq tx, level.width, cond;
   jmp cond, move-enemy-no-op;
   add target, dx, target;

   # move the enemy
   array-at level.map, target, tmp;
   neq tmp, Tile.player, cond;
   jmp cond, move-enemy-skip-player;
   set 1, level.dead;
   goto move-enemy-force;
move-enemy-skip-player:
   neq tmp, Tile.empty, cond;
   neq tmp, Tile.coin, cond2;
   and cond, cond2, cond;
   jmp cond, move-enemy-no-op;
move-enemy-force:
   array-set level.map, enemy.pos, enemy.tile;
   array-set level.map, target, enemy.type;
   set tmp, enemy.tile;
   set target, enemy.pos;

move-enemy-no-op:
   return;

# move all enemies
move-enemies(level)
   let i, n, cond, enemy, tmp, px, py;
   call px, py, get-x-y, level, level.plrpos;
   set 0, i;
   array-size level.enemies, n;
move-enemies-start:
   greq i, n, cond;
   jmp cond, move-enemies-end;

   array-at level.enemies, i, enemy;
   incr enemy.turn;
   jmptable enemy.type,
      Tile.vbat,     move-enemies-vbat,
      Tile.hbat,     move-enemies-hbat,
      Tile.glimmer,  move-enemies-glimmer,
      Tile.seeker,   move-enemies-seeker,
      Tile.observer, move-enemies-observer,
      Tile.wanderer, move-enemies-wanderer,
                     move-enemies-continue;

move-enemies-vbat:
   set enemy.pos, tmp;
   move-enemy level, enemy, enemy.dirx, enemy.diry;
   neq enemy.pos, tmp, cond;
   jmp cond, move-enemies-continue;
   neg enemy.diry, enemy.diry;
   goto move-enemies-continue;
move-enemies-hbat:
   set enemy.pos, tmp;
   move-enemy level, enemy, enemy.dirx, enemy.diry;
   neq enemy.pos, tmp, cond;
   jmp cond, move-enemies-continue;
   neg enemy.dirx, enemy.dirx;
   goto move-enemies-continue;
move-enemies-glimmer:
   set enemy.pos, tmp;
   move-enemy level, enemy, enemy.dirx, enemy.diry;
   neq enemy.pos, tmp, cond;
   jmp cond, move-enemies-continue;
   get-random-dir enemy;
   goto move-enemies-continue;
move-enemies-seeker:
   mod enemy.turn, 2, tmp;
   jmp tmp, move-enemies-continue;

   let ex, ey, dx, dy;
   call ex, ey, get-x-y, level, enemy.pos;
   call dx, get-dir, ex, px;
   call dy, get-dir, ey, py;

   move-enemy level, enemy, 0, dy;
   move-enemy level, enemy, dx, 0;
   goto move-enemies-continue;
move-enemies-observer:
   let distance;
   call ex, ey, get-x-y, level, enemy.pos;
   call distance, int-distance, ex, ey, px, py;

   greq distance, 3, cond;
   jmp cond, move-enemies-continue;
   call dx, get-dir, ex, px;
   call dy, get-dir, ey, py;

   neq dx, 0, cond;
   jmp cond, move-enemies-observer-x;
   move-enemy level, enemy, 0, dy;
   goto move-enemies-continue;
   move-enemies-observer-x:
   move-enemy level, enemy, dx, 0;
   goto move-enemies-continue;
move-enemies-wanderer:
   get-random-dir enemy;
   move-enemy level, enemy, enemy.dirx, enemy.diry;
   goto move-enemies-continue;
move-enemies-continue:
   incr i;
   goto move-enemies-start;
move-enemies-end:
