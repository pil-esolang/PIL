include "level.pil"

# game entry point
main()
   print "Input level to play (or help): ";
   local path, comp;
   readln path;

   string-trim path;
   neq path, "help", comp;
   jmp comp, main-not-help;
   help;
   string-free path;
   return;

main-not-help:
   local level;
   call level, create-level, path;
   string-free path;
   play-level level;
   deep-free level;

# list all files and some info about the game
help()
   print-lines "",
               "ASCII-GAME written in PIL",
               "This game is capable of loading and playing a level from a file. To play a specific level, simply type its name.",
               "You can also create your own levels, check out level files to see how it's done.",
               "Here's the file legend:",
               "\tp - player",
               "\te - empty",
               "\tb - block",
               "\tc - coin",
               "\tm - mine",
               "\tv - vertical bat",
               "\th - horizontal bat",
               "\tg - glimmer",
               "\ts - seeker",
               "\to - observer",
               "\tw - wanderer",
               "Here's a list of possible levels: ";

   local files, i, n, cond;
   dir-list-recursive ".", files;
   array-sort-asc files;
   set 0, i;
   array-size files, n;
help-start:
   greq i, n, cond;
   jmp cond, help-end;

   local file, idx, ext;
   array-at files, i, file;
   path-extension file, ext;
   string-empty ext, cond;
   jmpn cond, help-continue;
   path-is-dir file, cond;
   jmp cond, help-continue;
   println "\t", file;
help-continue:
   string-free ext;
   incr i;
   goto help-start;
help-end:
   array-deep-free files;
   println "\nHave fun! - Daniel Vishnevsky";
