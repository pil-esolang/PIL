@include "level.pil"

; game entry point
main()
   print "Input level to play (or help): "
   let path, comp
   readln path

   string-trim path
   neq path, "help", comp
   jmp comp, main-not-help
   help
   string-free path
   return

main-not-help:
   let level
   call level, create-level, path
   string-free path
   play-level level
   free level.map, level

; list all files and some info about the game
help()
   println "\nASCII-GAME written in PIL"
   println "This game is capable of loading and playing a level from a file."
   println "To play a specific level, simply type its name."
   println "Here's a list of possible levels: "

   let files, i, n, cond
   dir-list-recursive ".", files
   set 0, i
   array-size files, n
help-start:
   greq i, n, cond
   jmp cond, help-end

   let file, idx, ext
   array-at files, i, file
   path-extension file, ext
   string-empty ext, cond
   jmpn cond, help-continue
   add i, 1, idx
   println idx, ": ", file
help-continue:
   string-free ext
   incr i
   goto help-start
help-end:
   array-deep-free files
   println "\nHave fun! - Daniel Vishnevsky"
