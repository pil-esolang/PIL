# This file contains 2 factorial implementations -
# a recursive and an iterative variant.
factorial(n)
   local result, cond, minus1;
   leeq n, 1, cond;
   jmp cond, factorial-end;

   sub n, 1, minus1;
   call result, factorial, minus1;
   mul result, n, result;
   return result;
factorial-end:
   return 1;

factorial-iterative(n)
   local i, cond;
   leeq n, 1, cond;
   jmp cond, factorial-iterative-end;

   sub n, 1, i;
factorial-iterative-loop:
   mul n, i, n;
   decr i;
   gr i, 1, cond;
   jmp cond, factorial-iterative-loop;
   return n;
factorial-iterative-end:
   return 1;

# Test here.
main()
   local result;
   call result, factorial, 5.0;
   println result;
