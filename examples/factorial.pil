# This file contains 2 factorial implementations -
# a recursive and an iterative variant.
factorial(n)
   let result;
   leeq n, 1, $0;
   jmp $0, factorial-end;

   sub n, 1, $1;
   call result, factorial, $1;
   mul result, n, result;
   return result;
factorial-end:
   return 1;

factorial-iterative(n)
   let i;
   leeq n, 1, $0;
   jmp $0, factorial-iterative-end;

   sub n, 1, i;
factorial-iterative-loop:
   mul n, i, n;
   decr i;
   gr i, 1, $0;
   jmp $0, factorial-iterative-loop;
   return n;
factorial-iterative-end:
   return 1;

# Test here.
main()
   factorial 5.0;
   println r$0;
