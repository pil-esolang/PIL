# This file contains 2 different nth fibonacci
# number implementations. fib-iterative is by
# far the most efficient.
fib(n)
   let minus1, minus2, fib1, fib2, result;
   leeq n, 1, $0;
   jmp $0, fib-end;

   sub n, 1, minus1;
   sub n, 2, minus2;

   call fib1, fib, minus1;
   call fib2, fib, minus2;
   add fib1, fib2, result;
   return result;
fib-end:
   return n;

fib-iterative(n)
   let prev1, prev2, curr, i;
   leeq n, 1, $0;
   jmp $0, fib-iterative-end;

   set n, i;
   set 1, prev1;
   set 0, prev2;
   set 0, curr;

fib-iterative-loop:
   add prev1, prev2, curr;
   set prev1, prev2;
   set curr, prev1;
   decr i;
   gr i, 1, $2;
   jmp $2, fib-iterative-loop;
   return curr;
fib-iterative-end:
   return n;

# Test here.
main()
   fib 30;
   println R$0;
