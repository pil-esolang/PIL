# This file contains 2 different nth fibonacci
# number implementations. fib-iterative is by
# far the most efficient.
fib(n)
   local minus1, minus2, fib1, fib2, result, cond;
   leeq n, 1, cond;
   jmp cond, fib-end;

   sub n, 1, minus1;
   sub n, 2, minus2;

   call fib1, fib, minus1;
   call fib2, fib, minus2;
   add fib1, fib2, result;
   return result;
fib-end:
   return n;

fib-iterative(n)
   local prev1, prev2, curr, i, cond;
   leeq n, 1, cond;
   jmp cond, fib-iterative-end;

   set n, i;
   set 1, prev1;
   set 0, prev2;
   set 0, curr;

fib-iterative-loop:
   add prev1, prev2, curr;
   set prev1, prev2;
   set curr, prev1;
   decr i;
   gr i, 1, cond;
   jmp cond, fib-iterative-loop;
   return curr;
fib-iterative-end:
   return n;

# Test here.
main()
   local result;
   call result, fib, 30;
   println result;
