; legacy code written using the simplest instructions. outdated due to the
; @loop directive
main()
   set 1, $1        ; starting index
   set 100, $2      ; how many times to loop

loop:
   print $1         ; print current iteration
   add $1, 1, $1    ; increment by one
   leeq $1, $2, $3  ; check and store in $3
   jmp $3, loop     ; jump until i is larger than 100
