# 6 command calculator application. If you'd like
# something more, feel free to add more commands.
# Or even write up something more powerful, like
# a mathematical expression evaluator.

# Read a number from the user with error checking.
input-number(msg)
   let num, input;
   goto input-number-start;

input-number-error:
   print "Invalid input, try again.";

input-number-start:
   print msg;
   readln input;
   to-float input, num;
   string-free input;
   is-null num, input;
   jmp input, input-number-error;
   return num;

# Calculate the result based on the operator. We
# have a function table and just call the function
# with N1 and N2 as arguments.
calculate-result(n1, n2, op)
   let fn, tmp, result;
   valtable op, fn,
      '+', add,
      '-', sub,
      '*', mul,
      '/', div,
      '%', mod,
      '^', pow;

   is-null fn, tmp;
   jmpn tmp, valid-op;
   println "Invalid operator.";
   exit 0;
valid-op:
   func-call fn, n1, n2, result;
   return result;

# Main program entry point.
main()
   let n1, n2, op, result;
   call n1, input-number, "Input first number: ";
   call n2, input-number, "Input second number: ";
   print "Input operator (+,-,*,/,%,^): ";
   flush;
   readch op;
   println op; # readch does not print the character
   call result, calculate-result, n1, n2, op;
   printfln "{} {} {} = {}", n1, op, n2, result;
