# brainfuck esolang implementation.
# https://esolangs.org/wiki/Brainfuck

main()
   local code, memory, pc, i, ch, n, condition, depth, tmp;
   print "Input code: ";
   readln code;

   map-new memory;
   string-size code, n;
   set 0, i;
   set 0, pc;

main-loop-start:
   greq i, n, condition;
   jmp condition, main-loop-end;
   string-at code, i, ch;
   jmptable ch,
      '>',  brainfuck-right,
      '<',  brainfuck-left,
      '-',  brainfuck-minus,
      '+',  brainfuck-plus,
      '.',  brainfuck-write,
      ',',  brainfuck-read,
      '[',  brainfuck-start,
      ']',  brainfuck-end,
            main-loop-continue;

brainfuck-right:
   incr pc;
   goto main-loop-continue;
brainfuck-left:
   decr pc;
   goto main-loop-continue;
brainfuck-minus:
   map-at-or memory, pc, 0, tmp;
   decr tmp;
   le tmp, 0, condition;
   jmpn condition, minus-no-wrap;
   set 255, tmp;
minus-no-wrap:
   map-set memory, pc, tmp;
   goto main-loop-continue;
brainfuck-plus:
   map-at-or memory, pc, 0, tmp;
   incr tmp;
   gr tmp, 255, condition;
   jmpn condition, plus-no-wrap;
   set 0, tmp;
plus-no-wrap:
   map-set memory, pc, tmp;
   goto main-loop-continue;
brainfuck-write:
   map-at-or memory, pc, 0, tmp;
   to-char tmp, tmp;
   printch tmp;
   goto main-loop-continue;
brainfuck-read:
   readch tmp;
   to-int tmp, tmp;
   map-set memory, pc, tmp;
   goto main-loop-continue;
brainfuck-start:
   map-at-or memory, pc, 0, tmp;
   jmp tmp, main-loop-continue;
   set 1, depth;
   incr i;

   brainfuck-start-start:
      greq i, n, condition;
      jmp condition, main-loop-continue;

      string-at code, i, ch;
      eq ch, '[', tmp;
      add depth, tmp, depth;
      eq ch, ']', tmp;
      sub depth, tmp, depth;

      leeq depth, 0, condition;
      jmp condition, main-loop-continue;

      incr i;
      goto brainfuck-start-start;
brainfuck-end:
   map-at-or memory, pc, 0, tmp;
   jmpn tmp, main-loop-continue;
   set 1, depth;
   decr i;

   brainfuck-end-start:
      leeq depth, 0, condition;
      jmp condition, main-loop-continue;
      greq i, n, condition;
      jmp condition, main-loop-continue;

      string-at code, i, ch;
      eq ch, '[', tmp;
      sub depth, tmp, depth;
      eq ch, ']', tmp;
      add depth, tmp, depth;
      decr i;
      goto brainfuck-end-start;
main-loop-continue:
   incr i;
   goto main-loop-start;
main-loop-end:
   free code, memory;
